<h1>Account</h1>
<dl>
  <dt>Email</dt>
  <dd><%= Current.user.email_address %></dd>
  <dt>Name</dt>
  <dd><%= Current.user.name %></dd>
</dl>
<%= form_with model: Current.user, url: account_path, method: :patch do |f| %>
  <%= f.text_field :name %>
  <%= f.submit "Save" %>
<% end %>
<%= button_to "Sign Out", session_path, method: :delete %>
